---
import { siteConfig } from '../config/site';
import { copy } from '../lib/copy';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{copy('hero.eyebrow')}</p>
      <h1>{siteConfig.philosophy}</h1>
      <p class="hero-lead">{copy('hero.lead')}</p>

      <div class="hero-actions">
        <a class="button button--primary" href="/citas/">{copy('hero.appointment_cta')}</a>
        <a class="button button--secondary" href="/emergencia/">{copy('hero.emergency_cta')}</a>
      </div>
    </div>

    <div class="hero-placeholder" aria-label={copy('hero.image_aria_label')}>
      <span>{copy('hero.image_placeholder')}</span>
      <small>{copy('hero.image_note')}</small>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    background:
      radial-gradient(circle at 100% 0%, rgb(26 141 187 / 12%), transparent 32rem),
      linear-gradient(120deg, #eef4ff 0%, #fff 56%, #f0f8fa 100%);
  }

  .hero-grid {
    display: grid;
    min-height: 38rem;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .hero-copy {
    max-width: 45rem;
  }

  .hero-lead {
    max-width: 39rem;
    margin-top: var(--space-6);
    color: var(--text-secondary);
    font-size: clamp(1.125rem, 2vw, 1.3rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-placeholder {
    display: grid;
    min-height: 28rem;
    place-content: center;
    padding: var(--space-8);
    color: var(--brand-900);
    background: linear-gradient(145deg, var(--brand-100), #dceff4);
    border: 1px solid rgb(18 63 163 / 14%);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .hero-placeholder span {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .hero-placeholder small {
    max-width: 24rem;
    margin-top: var(--space-2);
    color: var(--text-secondary);
  }

  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-placeholder {
      min-height: 20rem;
    }
  }
</style>
