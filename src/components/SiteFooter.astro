---
import { primaryNavigation, siteConfig } from '../config/site';
import { copy } from '../lib/copy';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{siteConfig.name}</p>
      <p>{siteConfig.philosophy}</p>
      <p>{siteConfig.address}</p>
    </div>

    <div>
      <h2>{copy('footer.care_heading')}</h2>
      <a href="/emergencia/">{copy('footer.emergency_link')}</a>
      <a href="/citas/">{copy('footer.appointment_link')}</a>
      <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a>
    </div>

    <div>
      <h2>{copy('footer.navigation_heading')}</h2>
      {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>

  <div class="container footer-bottom">
    <small>© {new Date().getFullYear()} {siteConfig.name}. {copy('footer.rights')}</small>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-16);
    color: #dce6ff;
    background: var(--brand-900);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-12);
  }

  .footer-brand,
  .site-footer h2 {
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .footer-brand {
    margin-bottom: var(--space-3);
    font-size: 1.25rem;
  }

  .site-footer h2 {
    margin-bottom: var(--space-3);
    font-size: 1rem;
  }

  .site-footer p {
    max-width: 34rem;
    margin-bottom: var(--space-3);
  }

  .site-footer a {
    display: block;
    width: fit-content;
    margin-bottom: var(--space-2);
    color: #fff;
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.2em;
  }

  .footer-bottom {
    margin-top: var(--space-12);
    padding-block: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 16%);
  }

  @media (max-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
