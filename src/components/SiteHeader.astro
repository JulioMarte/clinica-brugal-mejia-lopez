---
import { primaryNavigation, siteConfig } from '../config/site';
import { copy } from '../lib/copy';
---

<header class="site-header">
  <div class="utility-bar">
    <div class="container utility-bar__inner">
      <a href={siteConfig.phoneHref}>{copy('header.emergency_label')} · {siteConfig.phoneDisplay}</a>
      <span>{siteConfig.address}</span>
    </div>
  </div>

  <div class="container header-row">
    <a class="brand" href="/" aria-label={`${siteConfig.name}, ${copy('a11y.home_label_suffix')}`}>
      <span class="brand-mark" aria-hidden="true">{copy('header.brand_mark')}</span>
      <span>
        <strong>{siteConfig.name}</strong>
        <small>{siteConfig.philosophy}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={copy('a11y.primary_navigation')}>
      {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="button button--primary header-cta" href="/citas/">{copy('header.appointment_cta')}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    background: rgb(255 255 255 / 96%);
    border-bottom: 1px solid var(--border-default);
    backdrop-filter: blur(0.75rem);
  }

  .utility-bar {
    color: #fff;
    background: var(--brand-900);
    font-size: 0.875rem;
  }

  .utility-bar__inner {
    display: flex;
    min-height: 2.25rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .utility-bar a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .header-row {
    display: flex;
    min-height: 5rem;
    align-items: center;
    gap: var(--space-8);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--brand-900);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    flex: 0 0 auto;
    color: #fff;
    background: var(--brand-700);
    border-radius: 50%;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-family: var(--font-heading);
    font-size: 1rem;
  }

  .brand small {
    max-width: 18rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.25;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-left: auto;
  }

  .desktop-nav a {
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .desktop-nav a:hover {
    color: var(--brand-700);
  }

  @media (max-width: 64rem) {
    .desktop-nav {
      display: none;
    }

    .header-cta {
      margin-left: auto;
    }
  }

  @media (max-width: 40rem) {
    .utility-bar__inner span {
      display: none;
    }

    .brand small,
    .header-cta {
      display: none;
    }
  }
</style>
